# Copy to .env and fill in. .env is gitignored and must stay that way.
#   cp .env.example .env
#
# Nothing here is needed to run the CPU-side pipeline. These are for the pod.

# Hugging Face — needed to pull model weights without rate limiting, and
# required if you later switch to a gated base model. Read-only token is enough.
# https://huggingface.co/settings/tokens
HF_TOKEN=

# Where the model cache lives. On RunPod, point this at the network volume so
# you are not re-downloading 6 GB of weights every time you start a pod.
HF_HOME=/workspace/.cache/huggingface

# Optional — training run tracking. Leave blank to disable.
WANDB_API_KEY=
WANDB_PROJECT=xbd-vlm-poc

# RunPod. Only needed for pod lifecycle from the CLI:
#   runpodctl config --apiKey $RUNPOD_API_KEY
#   runpodctl get pod / runpodctl stop pod <id>
# Not needed for the web console, and NOT needed for file transfer —
# `runpodctl send` / `receive` use one-time codes, no key involved.
#
# Blast radius: this key can create and destroy pods, i.e. spend money. Scope it
# as narrowly as RunPod allows, and delete it when the project is done.
RUNPOD_API_KEY=

# xView2 credentials are deliberately NOT here. See notes/dataset.md: the
# download uses signed links you copy from the site after logging in, which
# avoids storing a password and avoids a scraper that breaks on any page change.
