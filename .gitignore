# Secrets. .env.example is the tracked template; .env never is.
.env
.env.*
!.env.example

# Signed xView2 download links are time-limited credentials, not config.
configs/xbd_urls.txt

# Raw xBD — tens of GB, license-gated, never in git
data/raw/
data/chips/
data/processed/
data/labels.csv
data/*.tmp

# Adapters and generations
outputs/adapters/
outputs/eval/*.jsonl

# Metrics json IS tracked — it is the result
!outputs/eval/*.json

__pycache__/
*.pyc
.venv/
venv/
.DS_Store
.ipynb_checkpoints/

# Draft writeup — kept local until the structure is yours and it is fleshed out
WRITEUP.md

# Personal interview-prep notes, kept local
notes/interview-prep-*.md

# Figures: charts (no imagery) are tracked; composites containing xBD imagery are not
outputs/figures/07_chip_pairs.png
outputs/figures/08_inference_cards.png
outputs/figures/09_chipping.png
outputs/figures/gallery.html
